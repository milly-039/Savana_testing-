                  "var mobile = requestBody.mobile.toString();\r",
                  "var jsonData = pm.response.json();\r",
                  "\r",
                  "if (mobile.length === 10) {\r",
                  "    // VALID PARTITION: 10 digits\r",
                  "    pm.test(\"EP PASS: Valid Partition (10 digits). System accepted format.\", function () {\r",
                  "        pm.response.to.have.status(200);\r",
                  "        \r",
                  "        // If ret is 200, it's a success. \r",
                  "        // If ret is 100 but msg is 'valid mobile number', it means the number is already used/blocked,\r",
                  "        // but the LENGTH validation passed!\r",
                  "        if (jsonData.ret === 200) {\r",
                  "            pm.expect(jsonData.ret).to.eql(200);\r",
                  "        } else {\r",
                  "            pm.expect(jsonData.msg).to.not.include(\"length\");\r",
