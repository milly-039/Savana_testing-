          "name": "NFR 1- reliabliity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "/* * TECHNIQUE: Equivalence Partitioning (EP)\r",
                  " * ATTRIBUTE: Reliability (Graceful Error Handling)\r",
                  " * Valid Partition: Correct JSON structure (returns business data).\r",
                  " * Invalid Partition: Malformed JSON or Invalid Path (must return structured error).\r",
                  " */\r",
                  "\r",
                  "var jsonData;\r",
                  "\r",
                  "// We use a try-catch block because if the server crashes and sends \r",
                  "// non-JSON (like HTML), pm.response.json() itself will throw an error.\r",
                  "try {\r",
                  "    jsonData = pm.response.json();\r",
                  "} catch (e) {\r",
                  "    jsonData = null;\r",
                  "}\r",
                  "\r",
                  "pm.test(\"NFR PASS: Reliability - System returned structured SDUI JSON instead of crashing\", function () {\r",
                  "    // 1. Ensure the response is actually JSON\r",
                  "    pm.expect(jsonData).to.not.be.null;\r",
                  "    \r",
                  "    // 2. Ensure it contains the standard Savana 'ret' and 'msg' keys\r",
                  "    pm.expect(jsonData).to.have.property(\"ret\");\r",
                  "    pm.expect(jsonData).to.have.property(\"msg\");\r",
                  "    \r",
                  "    // 3. Logic for the Error Partition\r",
                  "    if (pm.response.code !== 200) {\r",
                  "        // If the URL is wrong (404), it should still be a clean JSON message\r",
                  "        pm.expect(jsonData.ret).to.not.eql(200);\r",
                  "        console.log(\"Reliability Check: System handled 4xx/5xx error gracefully with JSON message: \" + jsonData.msg);\r",
                  "    } else if (jsonData.ret !== 200) {\r",
                  "        // If the Body was malformed, it should return a 'wrong param' msg\r",
                  "        pm.expect(jsonData.msg).to.be.a(\"string\");\r",
                  "        console.log(\"Reliability Check: Business logic handled invalid input without server crash.\");\r",
                  "    }\r",
                  "});\r",
                  "\r",
                  "// Verification of Content-Type to prevent \"White Screen of Death\"\r",
                  "pm.test(\"NFR PASS: Header Safety - Content-Type is application/json\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
